# Copy this file to .env and fill in real values if you want AI-generated
# workout plans. The API works fine without this -- it will fall back to
# a sample plan automatically.

# Optional: enables real AI-generated workout plans via Anthropic's API.
ANTHROPIC_API_KEY=

# Secret used to sign login tokens. Use a long random text, and keep it private.
SECRET_KEY=change-me

# Optional: override the default SQLite database location.
# DATABASE_URL=sqlite:///fittrack.db
